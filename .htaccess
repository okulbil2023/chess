Options -MultiViews
DirectoryIndex dist/index.html index.html

RewriteEngine On
RewriteBase /chess/

# 1. Assets from dist
RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

# 2. Serve specific static files from dist if requested at root
RewriteRule ^(favicon\.ico|favicon-.*\.png|apple-touch-icon\.png|android-chrome-.*\.png|site\.webmanifest|ai-icon\.png|pvp_mode\.png|ai_mode\.png|vite\.svg)$ dist/$1 [L]

# 3. SPA Fallback: If not a real file or directory, serve the app
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . dist/index.html [L]
